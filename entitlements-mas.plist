<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build: App Sandbox is required. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Camera (document camera / Continuity Camera). -->
    <key>com.apple.security.device.camera</key><true/>
    <!-- StoreKit needs outbound network. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- Save snapshots / PDFs to a user-chosen location via the save panel. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Must match the Mac App Store provisioning profile (TeamID.BundleID + TeamID),
         or the upload is flagged 90886 and can't be used with TestFlight. -->
    <key>com.apple.application-identifier</key><string>XK6QP975ZQ.com.emerytech.BlueBirdDocuCam</string>
    <key>com.apple.developer.team-identifier</key><string>XK6QP975ZQ</string>
</dict>
</plist>
