# macOS native app build output (repo root only)
/build/
*.zip
*.dmg
*.pkg

# Signing material must never be committed (normally lives in ~/.config, not here)
*.cer
*.p12
*.key
*.certSigningRequest
*.provisionprofile
*.mobileprovision

